# /etc/stremio/subsync.env (root:<service user>, mode 640). deploy.sh creates and maintains it.
SUBSYNC_TOKEN=generate-with-openssl-rand-hex-16
PUBLIC_BASE=https://media.example.com/subsync

# AI translation (optional; any OpenAI-compatible chat API)
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL=deepseek-flash
#DEEPSEEK_THINKING=disabled
#TRANSLATE_SEGMENT_SECONDS=1200
#TRANSLATE_BATCH=80
#TRANSLATE_MAX_HISTORY_CHARS=200000
#TRANSLATE_AFTER_ALIGN_MS=120000
#ACTION_WAIT_MS=40000

# Alignment
#ENGINE_URL=http://127.0.0.1:11470
#UPSTREAM_URL=https://opensubtitles-v3.strem.io
#ALIGN_LANGS=eng,en,chi,zho,zht,zhs,chs,cht,ze,zh
#REF_SECONDS=600
#GOOD_CUES=0.55
#ALIGN_AUDIO=0

# Dictionary (click a word in the web player)
#YOUDAO_DICT_URL=https://dict.youdao.com/jsonapi
#YOUDAO_VOICE_URL=https://dict.youdao.com/dictvoice
#MYMEMORY_URL=https://api.mymemory.translated.net/get

# Vocabulary book (words saved from the dictionary popup; files under <CACHE_DIR>/vocab/)
# Header in which your reverse proxy names the logged-in user (see examples/nginx-subsync.conf).
# Unset: every browser gets a book of its own, keyed by a random id it keeps in localStorage.
#VOCAB_USER_HEADER=X-Subsync-User
#VOCAB_NAME_HEADER=X-Subsync-User-Name
#VOCAB_MAX_WORDS=5000

# Download library (videos fetched to this server ahead of time)
#LIBRARY_MAX_GB=50
#LIBRARY_MIN_FREE_GB=10
#LIBRARY_CONCURRENCY=1
# downloads use aria2c when it is installed and fall back to the streaming engine; "engine" skips aria2
#LIBRARY_DOWNLOADER=auto
#ARIA2_BIN=aria2c
# URL under which your web server serves /var/lib/stremio-subsync/library itself (see nginx-subsync.conf);
# without it the addon serves the files under its token path
#LIBRARY_PUBLIC_BASE=https://media.example.com/library
# extra trackers for downloads, comma separated (default: a built-in list of public ones)
#LIBRARY_TRACKERS=udp://tracker.opentrackr.org:1337/announce
